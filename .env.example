# Copy this file to .env.local for local development.
# None of these are required to run the site locally — the contact form
# works and simply logs submissions server-side until you wire up a
# provider. See src/app/api/contact/route.ts.

# Public site URL, used for metadata, Open Graph tags, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.coseke.com

# --- Contact form (optional, pick one provider and wire it up in
#     src/app/api/contact/route.ts) ---

# Resend (https://resend.com)
# RESEND_API_KEY=
# CONTACT_FORM_TO_EMAIL=sales.ke@coseke.com

# Or SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=

# Or push leads into a CRM instead of / as well as email
# HUBSPOT_API_KEY=
